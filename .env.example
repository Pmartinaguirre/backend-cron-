# Copia este archivo a ".env" (local) o cárgalas como variables de entorno
# en Render — nunca subas el ".env" real a git.

# Supabase del proyecto "Polla mundialera 2026" (o el que corresponda)
SUPABASE_URL=https://tu-proyecto.supabase.co
# La service_role key (NO la anon/public) — esta sí puede escribir sin
# pelear con las políticas RLS de lectura pública.
SUPABASE_SERVICE_KEY=

# Tu key de api-football.com (plan Pro, 75.000+ consultas/día)
API_FOOTBALL_KEY=

# Clave secreta inventada por ti — cron-job.org debe mandarla en el header
# "X-Cron-Secret" en cada llamada. Sin esto, cualquiera que encuentre la URL
# del backend podría disparar los endpoints (crear partidos, pagar diamantes,
# etc.) sin permiso. Invéntate algo largo y random.
CRON_SECRET=

# Puerto en el que corre el server (Render lo pisa solo con su propia
# variable PORT, esto es solo para correrlo en tu compu).
PORT=3000

# URL pública del frontend (Netlify) — se usa para armar los links de los
# mails (resumen de Check!, y los 4 mails de "hitos" de abajo).
FRONTEND_URL=https://demaster.app

# Resend (https://resend.com) — para mandar mails con contenido armado a
# medida. Es DISTINTO del mail que ya manda Supabase Auth para
# login/confirmación de cuenta — ese no sirve para esto. Se usa en:
#   - /enviar-resumen-mesa (resumen de Check! al cerrar una mesa).
#   - Los 4 mails de "hitos" del jugador (src/rutas/notificaciones.js):
#     registro, invitación a grupo, grupo creado, grupo activado.
# Plan gratis de Resend: 100 mails/día · 3.000/mes, alcanza de sobra.
RESEND_API_KEY=
# Remitente: tiene que ser de un dominio VERIFICADO en tu cuenta de Resend
# (Resend → Domains → Add Domain → agregar los registros DNS que te da).
# Sin verificar, Resend solo deja mandar al mail con el que te registraste
# en Resend — cualquier otro destinatario rebota. Ej. una vez verificado:
# "Demaster.app <hola@demaster.app>".
RESEND_FROM_EMAIL=
